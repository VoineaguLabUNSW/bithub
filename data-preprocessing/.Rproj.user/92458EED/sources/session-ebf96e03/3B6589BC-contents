## Plots

bspan <- read.csv("/home/neuro/Documents/BrainData/Bulk/BrainSpan/Formatted/BrainSpan-varPart.csv", header=TRUE, check.names = FALSE, row.name =1) %>%
   rownames_to_column("Gene")

long_df <- bspan %>%
  pivot_longer(
    cols = -Gene,
    names_to = "Category",
    values_to = "Variance_Explained"
  )

bspan %<>%
  dplyr::select(-Gene)

ordered_levels <- long_df %>%
  dplyr::filter(Category != "Residuals") %>%
  group_by(Category) %>%
  summarise(median_var = median(Variance_Explained, na.rm = TRUE)) %>%
  arrange(desc(median_var)) %>%
  pull(Category)

# Add "Residuals" at the end
final_levels <- c(ordered_levels, "Residuals")

# Set factor levels for plotting
long_df <- long_df %>%
  mutate(Category = factor(Category, levels = final_levels))

# Plot violin + boxplot
bspan_varPar = ggplot(long_df, aes(x = Category, y = Variance_Explained * 100)) +
 # geom_violin() +
  geom_boxplot(fill = "#A27BB1") +
 # geom_jitter(width = 0.1, size = 0.5, alpha = 0.3) +
  labs(
    y = "Percentage (%) Variance Explained",
    x = " ",
    title = "BrainSpan"
  ) +
  theme_bw() + theme(axis.text.x = element_text(size = 12, family = "serif", color = "black", angle = 75, hjust =1),
              axis.text.y = element_text(size = 12, family = "serif", color = "black"),
              axis.title = element_text(size=15, family = "serif"),
              legend.box.background = element_rect(color = "black"),
              legend.text = element_text(family = "serif"),
              legend.title = element_text( family = "serif"),
              plot.title = element_text(family = "serif", size =20),
              panel.grid.major.x = element_blank(),
              panel.grid.major.y = element_line( size=.1 ),
              legend.position = "none")


