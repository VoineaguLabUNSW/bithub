# Copy to .env before building:  cp .env.example .env
#
# Vite inlines these at BUILD time (see src/lib/config.js). This is a static
# site with no server, so the values cannot be changed after `npm run build`.
# Both are optional — the build succeeds without a .env at all.

# Base URL of the Ask BITHub chat backend (chatbot/ FastAPI service).
# Leave empty when that process also serves the built site: the frontend is
# then same-origin and needs no absolute URL.
VITE_CHAT_API=http://localhost:8000

# Show the "Ask BITHub" entry point on the home page in a PRODUCTION build.
# `vite dev` always shows it regardless. Keep false for the CI deploy to
# GitHub Pages — the public site must not advertise a chat that spends
# Anthropic credits with no rate limit in front of it.
VITE_SHOW_CHAT=false
